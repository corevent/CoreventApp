<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.CheckInPage"
             x:DataType="vm:CheckInViewModel"
             Title="Credenciamento"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource White}">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             IconSize="18"
                             IconColor="{StaticResource primary_text_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 Spacing="2">
                <Label Text="Credenciamento"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding EventName}"
                       FontSize="12"
                       TextColor="{StaticResource secondary_text_color}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Scanner Area -->
        <Grid Grid.Row="1"
              Padding="20,0">

            <!-- Camera Viewfinder (1:1 square) -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 32"
                    BackgroundColor="{StaticResource Gray100}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    HeightRequest="320">
                <Grid>
                    <!-- Camera feed -->
                    <zxing:CameraBarcodeReaderView
                        x:Name="cameraReader"
                        IsDetecting="{Binding IsScanning}"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        Margin="-1"/>

                    <!-- Overlay when scanner is blocked -->
                    <VerticalStackLayout IsVisible="{Binding IsScannerBlocked}"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="8"
                                         BackgroundColor="#80FFFFFF"
                                         Padding="20">
                        <mi:MauiIcon Icon="{mi:Cupertino Nosign}"
                                     IconSize="40"
                                     IconColor="{StaticResource primary_text_color}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>
                        <Label Text="{Binding ResultMessage}"
                               FontSize="14"
                               TextColor="{StaticResource error_color}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Result overlay -->
                    <Border IsVisible="{Binding IsResultVisible}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#E8F5E9"
                            VerticalOptions="End"
                            HorizontalOptions="Center"
                            Margin="20">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsResultSuccess}"
                                         Value="False">
                                <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto, *"
                              Padding="16,12"
                              ColumnSpacing="12">
                            <mi:MauiIcon Icon="{mi:Cupertino Checkmark}"
                                         IconSize="20"
                                         IconColor="#16A34A"
                                         VerticalOptions="Center">
                                <mi:MauiIcon.Triggers>
                                    <DataTrigger TargetType="mi:MauiIcon"
                                                 Binding="{Binding IsResultSuccess}"
                                                 Value="False">
                                        <Setter Property="Icon" Value="{mi:Cupertino Xmark}"/>
                                        <Setter Property="IconColor" Value="#DC2626"/>
                                    </DataTrigger>
                                </mi:MauiIcon.Triggers>
                            </mi:MauiIcon>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding ResultMessage}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#16A34A">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsResultSuccess}"
                                                     Value="False">
                                            <Setter Property="TextColor" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="Toque para continuar"
                                       FontSize="11"
                                       TextColor="{StaticResource secondary_text_color}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsResultSuccess}"
                                                     Value="False">
                                            <Setter Property="Text" Value="Toque para tentar novamente"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissResultCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Section -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="16"
                             Padding="20,0,20,20"
                             VerticalOptions="End">
            <Label Text="Posicione o QR Code dentro do quadrado para escanear"
                   FontSize="13"
                   TextColor="{StaticResource secondary_text_color}"
                   HorizontalTextAlignment="Center"/>
            <Label Text="COREVENT SECURITY SCANNER V1.0"
                   FontSize="10"
                   TextColor="{StaticResource Gray300}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
