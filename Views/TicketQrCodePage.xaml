<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.TicketQrCodePage"
             x:DataType="vm:TicketQrCodeViewModel"
             Title="Meu Ingresso"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource White}">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   Text="Meu Ingresso"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Ticket Card -->
        <ScrollView Grid.Row="1" Padding="20,24">
            <Border Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{StaticResource White}"
                    Padding="0">

                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                    <!-- Top accent bar (colored by status) -->
                    <Border Grid.Row="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24 24 0 0"
                            HeightRequest="8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="pending">
                                <Setter Property="BackgroundColor" Value="#D97706"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="paid">
                                <Setter Property="BackgroundColor" Value="#16A34A"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="checked_in">
                                <Setter Property="BackgroundColor" Value="#2563EB"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="cancelled">
                                <Setter Property="BackgroundColor" Value="#DC2626"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Event & ticket info -->
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="8"
                                         Padding="20,16">
                        <Label Text="{Binding EventTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"
                               LineBreakMode="TailTruncation"/>

                        <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8">
                            <Border Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    VerticalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="pending">
                                        <Setter Property="BackgroundColor" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="paid">
                                        <Setter Property="BackgroundColor" Value="#DCFCE7"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="checked_in">
                                        <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="cancelled">
                                        <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="pending">
                                            <Setter Property="Text" Value="Pendente"/>
                                            <Setter Property="TextColor" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="paid">
                                            <Setter Property="Text" Value="Confirmado"/>
                                            <Setter Property="TextColor" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="checked_in">
                                            <Setter Property="Text" Value="Finalizado"/>
                                            <Setter Property="TextColor" Value="#2563EB"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="cancelled">
                                            <Setter Property="Text" Value="Cancelado"/>
                                            <Setter Property="TextColor" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="8,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource primary_orange_color}"
                                    VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <mi:MauiIcon Icon="{mi:Cupertino Qrcode}"
                                                 IconSize="12"
                                                 IconColor="{StaticResource White}"
                                                 VerticalOptions="Center"/>
                                    <Label Text="{Binding TicketTypeName}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_orange_color}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <HorizontalStackLayout Spacing="4">
                            <Label Text="R$"
                                   FontSize="14"
                                   TextColor="{StaticResource primary_text_color}"
                                   FontAttributes="Bold"
                                   VerticalOptions="End"/>
                            <Label Text="{Binding Price, StringFormat='{0:F2}'}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Dashed divider -->
                    <BoxView Grid.Row="2"
                             HeightRequest="1"
                             Margin="20,0"
                             Color="{StaticResource Gray200}"/>

                    <!-- QR Code -->
                    <VerticalStackLayout Grid.Row="3"
                                         Spacing="12"
                                         Padding="20,20"
                                         HorizontalOptions="Center">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource White}"
                                WidthRequest="240"
                                HeightRequest="240"
                                HorizontalOptions="Center">
                            <Grid>
                                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                                   IsVisible="{Binding IsLoading}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Color="{StaticResource primary_orange_color}"/>
                                <Image Source="{Binding QrCodeSource}"
                                       WidthRequest="220"
                                       HeightRequest="220"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Aspect="AspectFit"/>
                            </Grid>
                        </Border>
                        <Label Text="Apresente esse QR Code na entrada do evento"
                               FontSize="12"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Footer -->
                    <BoxView Grid.Row="4"
                             HeightRequest="1"
                             Margin="20,0"
                             Color="{StaticResource Gray200}"/>

                    <VerticalStackLayout Grid.Row="4"
                                         Spacing="4"
                                         Padding="20,14"
                                         BackgroundColor="{StaticResource Gray50}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Pedido:"
                                   FontSize="11"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Text="{Binding OrderId}"
                                   FontSize="11"
                                   TextColor="{StaticResource Gray400}"
                                   LineBreakMode="MiddleTruncation"
                                   MaximumWidthRequest="200"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Ingresso:"
                                   FontSize="11"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Text="{Binding TicketId}"
                                   FontSize="11"
                                   TextColor="{StaticResource Gray400}"
                                   LineBreakMode="MiddleTruncation"
                                   MaximumWidthRequest="200"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </Grid>
            </Border>
        </ScrollView>

    </Grid>
</ContentPage>
