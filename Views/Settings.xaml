<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.Settings"
             x:DataType="vm:SettingsViewModel"
             Title="Configurações"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header: Matching Home.xaml style -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *, Auto" 
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <Label Text="←" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="{StaticResource primary_text_color}"
                       FontSize="18"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            
            <Label Grid.Column="1"
                   Text="Configurações"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content: Matching Home.xaml spacing (16,14,16,20) and spacing (18) -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20" Spacing="18">
                
                <!-- PREFERÊNCIAS -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="PREFERÊNCIAS"
                           FontSize="12" 
                           TextColor="{StaticResource secondary_text_color}" 
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           Margin="4,0"/>
                    
                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource White}"
                            Padding="12,4">
                        <VerticalStackLayout Spacing="0">
                            <!-- Notificações Push -->
                            <Grid ColumnDefinitions="40, *, 40" HeightRequest="56">
                                <Border BackgroundColor="#F3F5F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="bell.png" HeightRequest="18" WidthRequest="18"/>
                                </Border>
                                <Label Grid.Column="1" Text="Notificações Push" VerticalOptions="Center" Margin="12,0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}"/>
                                <Switch Grid.Column="2" IsToggled="{Binding IsPushNotificationsEnabled}" OnColor="{StaticResource primary_orange_color}" VerticalOptions="Center"/>
                            </Grid>
                            
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="48,0,0,0"/>

                            <!-- Modo Escuro -->
                            <Grid ColumnDefinitions="40, *, 40" HeightRequest="56">
                                <Border BackgroundColor="#F3F5F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="moon.png" HeightRequest="18" WidthRequest="18"/>
                                </Border>
                                <Label Grid.Column="1" Text="Modo Escuro" VerticalOptions="Center" Margin="12,0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}"/>
                                <Switch Grid.Column="2" IsToggled="{Binding IsDarkModeEnabled}" OnColor="{StaticResource primary_orange_color}" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="48,0,0,0"/>

                            <!-- Idioma -->
                            <Grid ColumnDefinitions="40, *, Auto" HeightRequest="56">
                                <Border BackgroundColor="#F3F5F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="globe.png" HeightRequest="18" WidthRequest="18"/>
                                </Border>
                                <Label Grid.Column="1" Text="Idioma" VerticalOptions="Center" Margin="12,0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}"/>
                                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding CurrentLanguage}" TextColor="{StaticResource secondary_text_color}" VerticalOptions="Center" FontSize="13"/>
                                    <Label Text="&gt;" FontSize="18" TextColor="#C7C7CC" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToDetailCommand}" CommandParameter="Language"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SEGURANÇA -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="SEGURANÇA" 
                           FontSize="12" 
                           TextColor="{StaticResource secondary_text_color}" 
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           Margin="4,0"/>
                    
                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource White}"
                            Padding="12,4">
                        <VerticalStackLayout Spacing="0">
                            <!-- Métodos de Pagamento -->
                            <Grid ColumnDefinitions="40, *, Auto" HeightRequest="56">
                                <Border BackgroundColor="#F3F5F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="credit_card.png" HeightRequest="18" WidthRequest="18"/>
                                </Border>
                                <Label Grid.Column="1" Text="Pagamento" VerticalOptions="Center" Margin="12,0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}"/>
                                <Label Grid.Column="2" Text="&gt;" FontSize="18" TextColor="#C7C7CC" VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToDetailCommand}" CommandParameter="Payment"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SUPORTE -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="SUPORTE" 
                           FontSize="12" 
                           TextColor="{StaticResource secondary_text_color}" 
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           Margin="4,0"/>
                    
                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource White}"
                            Padding="12,4">
                        <VerticalStackLayout Spacing="0">
                            <!-- Central de Ajuda -->
                            <Grid ColumnDefinitions="40, *, Auto" HeightRequest="56">
                                <Border BackgroundColor="#F3F5F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="circle_question_mark.png" HeightRequest="18" WidthRequest="18"/>
                                </Border>
                                <Label Grid.Column="1" Text="Central de Ajuda" VerticalOptions="Center" Margin="12,0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}"/>
                                <Label Grid.Column="2" Text="&gt;" FontSize="18" TextColor="#C7C7CC" VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToDetailCommand}" CommandParameter="Help"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                            
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="48,0,0,0"/>

                            <!-- Fale Conosco -->
                            <Grid ColumnDefinitions="40, *, Auto" HeightRequest="56">
                                <Border BackgroundColor="#F3F5F8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="message_square.png" HeightRequest="18" WidthRequest="18"/>
                                </Border>
                                <Label Grid.Column="1" Text="Fale Conosco" VerticalOptions="Center" Margin="12,0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}"/>
                                <Label Grid.Column="2" Text="&gt;" FontSize="18" TextColor="#C7C7CC" VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToDetailCommand}" CommandParameter="Contact"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
