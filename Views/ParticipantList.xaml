<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.ParticipantList"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:ParticipantListViewModel"
             x:Name="ThisPage"
             Title="Inscritos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *"
          Padding="16,14,16,0">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              VerticalOptions="Center"
              Margin="0,0,0,16">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <VerticalStackLayout Grid.Column="1"
                                 Margin="12,0,0,0"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <Label Text="Inscritos"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"/>
                <Label Text="{Binding EventName}"
                       FontSize="12"
                       TextColor="{StaticResource secondary_text_color}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1"
                    Margin="0,0,0,16">
            <VerticalStackLayout Spacing="16">

                <!-- Participants Card -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="16,16,16,4">

                    <VerticalStackLayout Spacing="0">

                        <!-- Table Header -->
                        <Grid ColumnDefinitions="*, Auto"
                              Padding="0,0,0,12">
                            <Label Text="PARTICIPANTE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Grid.Column="1"
                                   Text="INGRESSOS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource secondary_text_color}"/>
                        </Grid>

                        <!-- Participant List -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ParticipantSummary">
                                    <VerticalStackLayout>
                                        <!-- Separator -->
                                        <BoxView HeightRequest="1"
                                                 Color="{StaticResource Gray100}"
                                                 HorizontalOptions="Fill"
                                                 Margin="0,0,0,0"/>

                                        <Grid ColumnDefinitions="Auto, *, Auto"
                                              Padding="0,12,0,12"
                                              ColumnSpacing="12">

                                            <!-- Avatar Circle -->
                                            <Border WidthRequest="40"
                                                    HeightRequest="40"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 20"
                                                    BackgroundColor="{StaticResource card_icon_bg}"
                                                    HorizontalOptions="Start">
                                                <Label Text="{Binding Initial}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Name + Email -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"/>
                                                <Label Text="{Binding Email}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource secondary_text_color}"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TicketsCount}"
                                                              FontSize="15"
                                                              FontAttributes="Bold"
                                                              TextColor="{StaticResource primary_text_color}"/>
                                                        <Span Text="x"
                                                              FontSize="11"
                                                              TextColor="{StaticResource secondary_text_color}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Empty State -->
                <Label Text="Nenhum participante encontrado"
                       FontSize="14"
                       TextColor="{StaticResource secondary_text_color}"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"
                       IsVisible="{Binding IsEmpty}"/>

                <!-- Export Button -->
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource purchase_btn_bg}"
                        StrokeShape="RoundRectangle 14"
                        HeightRequest="48">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExportCsvCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *"
                          Padding="16,0"
                          VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Cupertino ArrowDownDoc}"
                                     IconSize="16"
                                     IconColor="{StaticResource White}"
                                     VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Exportar Lista (CSV)"
                               TextColor="{StaticResource White}"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="White"
                                   HeightRequest="48"
                                   WidthRequest="48"/>
                <Label Text="Carregando..."
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
