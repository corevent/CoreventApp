<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.Login"
             Title="Login">
    <VerticalStackLayout Spacing="120" Padding="10" BackgroundColor="{StaticResource background_color}">
        <Label 
            Text="Corevent"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="40"
            TextColor="{StaticResource primary_text_color}"/>

        <VerticalStackLayout>
            <Label 
            Text="Bem-vindo de volta!"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            TextColor="{StaticResource primary_text_color}"/>
            <Label 
            Text="Sentimos sua falta. Entre para continuar explorando."
            VerticalOptions="Center"
            HorizontalOptions="Center"
            TextColor="{StaticResource secondary_text_color}"/>
        </VerticalStackLayout>

        <Button Text="Entrar" HorizontalOptions="Center" Clicked="Button_Clicked_Entrar"/>
    </VerticalStackLayout>
</ContentPage>