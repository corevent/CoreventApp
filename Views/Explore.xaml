<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.Explore"
             x:DataType="vm:ExploreViewModel"
             x:Name="ThisPage"
             Title="Explorar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Row 0: Search -->
        <Grid Grid.Row="0"
              Padding="16,14,16,10">
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource White}"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto, *"
                      ColumnSpacing="8">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="28"
                            HeightRequest="28"
                            VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Cupertino Search}"
                                         IconSize="14"
                                         IconColor="{StaticResource secondary_text_color}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                    </Border>
                    <Entry Grid.Column="1"
                           Placeholder="Buscar eventos..."
                           PlaceholderColor="{StaticResource secondary_text_color}"
                           Text="{Binding SearchText}"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{StaticResource primary_text_color}"
                           BackgroundColor="Transparent"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Category Chips -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="16,0,16,0">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}"
                                   Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryItem">
                        <Border HeightRequest="36"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
                                    <Setter Property="Stroke" Value="{StaticResource Gray100}"/>
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource primary_orange_color}"/>
                                            <Setter Property="Stroke" Value="{StaticResource primary_orange_color}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Label Text="{Binding Name}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="{StaticResource secondary_text_color}"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Row 2: Events List -->
        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding Events}"
                         Margin="16,14,16,20">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="40">
                    <Label Text="Nenhum evento encontrado"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource secondary_text_color}"
                           HorizontalOptions="Center"/>
                    <Label Text="Tente buscar por outra categoria ou termo"
                           FontSize="13"
                           TextColor="{StaticResource secondary_text_color}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EventSummary">
                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource White}">
                        <Grid ColumnDefinitions="100, *">
                            <!-- Left: Image + Favorite -->
                            <Border WidthRequest="100"
                                    HeightRequest="100"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20,0,20,0">
                                <Grid>
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding ImageUrl, Converter={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Source" Value="profile_default_icon.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Favorite Button -->
                                    <Border WidthRequest="26"
                                            HeightRequest="26"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,5,5,0">
                                        <mi:MauiIcon IconSize="13"
                                                     IconColor="{StaticResource secondary_text_color}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                            <mi:MauiIcon.Style>
                                                <Style TargetType="mi:MauiIcon">
                                                    <Setter Property="Icon" Value="{mi:Cupertino Heart}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="mi:MauiIcon" Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Icon" Value="{mi:Cupertino HeartFill}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </mi:MauiIcon.Style>
                                        </mi:MauiIcon>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Right: Details -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="12,10,12,10"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                                        CommandParameter="{Binding}"/>
                                </VerticalStackLayout.GestureRecognizers>

                                <!-- Category + Type row -->
                                <Grid ColumnDefinitions="Auto, Auto, *">
                                    <Label Text="{Binding Category}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource secondary_text_color}"
                                           VerticalOptions="Center"/>

                                    <Border Grid.Column="1"
                                            Padding="6,2"
                                            Margin="6,0,0,0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="Presencial">
                                                        <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="Hibrido">
                                                        <Setter Property="BackgroundColor" Value="#F3E8FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Label FontSize="9"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="Text" Value="Online"/>
                                                    <Setter Property="TextColor" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Presencial">
                                                            <Setter Property="Text" Value="Presencial"/>
                                                            <Setter Property="TextColor" Value="#2563EB"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Hibrido">
                                                            <Setter Property="Text" Value="Híbrido"/>
                                                            <Setter Property="TextColor" Value="#7C3AED"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                    </Border>
                                </Grid>

                                <!-- Title -->
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_text_color}"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Location / Online -->
                                <Grid>
                                    <!-- Presencial / Hibrido -->
                                    <HorizontalStackLayout Spacing="4"
                                                           IsVisible="False">
                                        <HorizontalStackLayout.Style>
                                            <Style TargetType="HorizontalStackLayout">
                                                <Setter Property="IsVisible" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Type}" Value="Presencial">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Type}" Value="Hibrido">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </HorizontalStackLayout.Style>
                                        <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                                                     IconSize="11"
                                                     IconColor="{StaticResource secondary_text_color}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"/>
                                        <Label Text="{Binding Location}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- Remoto -->
                                    <HorizontalStackLayout Spacing="4"
                                                           IsVisible="False">
                                        <HorizontalStackLayout.Style>
                                            <Style TargetType="HorizontalStackLayout">
                                                <Setter Property="IsVisible" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Type}" Value="Remoto">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </HorizontalStackLayout.Style>
                                        <mi:MauiIcon Icon="{mi:Cupertino Globe}"
                                                     IconSize="11"
                                                     IconColor="{StaticResource secondary_text_color}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"/>
                                        <Label Text="Evento Online"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Date + Price row -->
                                <Grid ColumnDefinitions="Auto, *"
                                      Margin="0,2,0,0">
                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                                     IconSize="11"
                                                     IconColor="{StaticResource secondary_text_color}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"/>
                                        <Label Text="{Binding Date}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding Price}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{StaticResource primary_text_color}"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Price}" Value="Grátis">
                                                        <Setter Property="TextColor" Value="{StaticResource status_success_text}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
