<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.AddPixKey"
             x:DataType="vm:AddPixKeyViewModel"
             Title="Adicionar Chave Pix"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <Label Text="←"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource primary_text_color}"
                       FontSize="18"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Adicionar Chave Pix"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="18">

                <!-- Key Type -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Tipo de Chave" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,0">
                        <Picker ItemsSource="{Binding KeyTypes}" 
                                SelectedItem="{Binding SelectedKeyType}" 
                                Title="Selecione o tipo"
                                TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Key Value -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Chave Pix" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                        <Entry Text="{Binding KeyValue}" Placeholder="Insira sua chave aqui" TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Action Button -->
                <Button Text="Adicionar Chave"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource primary_orange_color}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="56"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
