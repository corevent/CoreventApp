<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.EditProfile"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             Title="EditProfile"
             BackgroundColor="{StaticResource background_color}">
    <ScrollView>
        <Grid RowDefinitions="auto, *" Padding="20" RowSpacing="24">

            <!-- Header -->
            <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             IconSize="18"
                             IconColor="{StaticResource primary_text_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1"
                    Text="Editar Perfil"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource primary_text_color}"
                    VerticalOptions="Center"
                    Margin="12,0,0,0"/>
            </Grid>

            <!-- Form -->
            <Grid Grid.Row="1" RowDefinitions="auto, auto, auto, auto" RowSpacing="24">

                    <!-- NOME COMPLETO -->
                    <Grid Grid.Row="0" RowDefinitions="auto, auto" RowSpacing="6">
                        <Label Grid.Row="0"
                               Text="NOME COMPLETO"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"/>
                        <Border Grid.Row="1"
                                Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="12,0">
                            <Entry Text="{Binding UserName}"
                                   Placeholder="Seu nome completo"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource input_text}"/>
                        </Border>
                    </Grid>

                    <!-- CPF -->
                    <Grid Grid.Row="1" RowDefinitions="auto, auto" RowSpacing="6">
                        <Label Grid.Row="0"
                               Text="CPF"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"/>
                        <Border Grid.Row="1"
                                Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="12,0">
                            <Entry Text="{Binding UserCpf}"
                                   Placeholder="000.000.000-00"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource input_text}"/>
                        </Border>
                    </Grid>

                    <!-- DATA DE NASCIMENTO -->
                    <Grid Grid.Row="2" RowDefinitions="auto, auto" RowSpacing="6">
                        <Label Grid.Row="0"
                               Text="DATA DE NASCIMENTO"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"/>
                        <Border Grid.Row="1"
                                Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="12,0">
                            <DatePicker Date="{Binding BirthDate}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource input_text}"/>
                        </Border>
                    </Grid>

                    <!-- Botão Salvar -->
                    <Button Grid.Row="3"
                            Text="Salvar Alterações"
                            Command="{Binding SaveCommand}"
                            Background="{StaticResource gradient_button}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            Margin="0,8,0,0"/>
                </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
