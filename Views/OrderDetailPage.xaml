<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.OrderDetailPage"
             x:DataType="vm:OrderDetailViewModel"
             Title="Detalhes do Pedido"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource White}">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   Text="Detalhes do Pedido"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,24">
            <VerticalStackLayout Spacing="16">

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   Margin="0,40,0,0"
                                   Color="{StaticResource primary_orange_color}"/>

                <!-- Order Summary Card -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="16">

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="48, *" ColumnSpacing="12">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    HeightRequest="48"
                                    WidthRequest="48"
                                    BackgroundColor="{StaticResource Gray100}">
                                <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                             IconSize="22"
                                             IconColor="{StaticResource primary_orange_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Order.Event.Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_text_color}"
                                       LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="4">
                                    <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                                 Style="{StaticResource SmallIcon}"
                                                 IconSize="12"
                                                 IconColor="{StaticResource secondary_text_color}"/>
                                    <Label Text="{Binding Order.Event.StartDate, StringFormat='{0:dd MMM, yyyy}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="0.5" Color="{StaticResource Gray100}"/>

                        <!-- Total + status -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TOTAL"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource secondary_text_color}"/>
                                <Label FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_text_color}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="R$ "/>
                                            <Span Text="{Binding Order.TotalAmount, StringFormat='{0:F2}'}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Padding="12,5"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    VerticalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="paid">
                                        <Setter Property="BackgroundColor" Value="#DCFCE7"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="pending">
                                        <Setter Property="BackgroundColor" Value="#FEF3C7"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Order.Status}" Value="cancelled">
                                        <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Order.Status}" Value="paid">
                                            <Setter Property="Text" Value="CONCLUÍDO"/>
                                            <Setter Property="TextColor" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Order.Status}" Value="pending">
                                            <Setter Property="Text" Value="PENDENTE"/>
                                            <Setter Property="TextColor" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Order.Status}" Value="cancelled">
                                            <Setter Property="Text" Value="CANCELADO"/>
                                            <Setter Property="TextColor" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>

                        <!-- Order date -->
                        <HorizontalStackLayout Spacing="4">
                            <mi:MauiIcon Icon="{mi:Cupertino ClockFill}"
                                         Style="{StaticResource SmallIcon}"
                                         IconSize="12"
                                         IconColor="{StaticResource secondary_text_color}"/>
                            <Label Text="{Binding Order.CreatedAt, StringFormat='Pedido realizado em {0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="11"
                                   TextColor="{StaticResource secondary_text_color}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tickets Title -->
                <Label Text="Ingressos"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"
                       Margin="0,4,0,0"/>

                <!-- Tickets list -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Tickets}">
                    <BindableLayout.EmptyView>
                        <Label Text="Nenhum ingresso neste pedido"
                               FontSize="14"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0"/>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:OrderTicketDto">
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="14">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                                    <Label Text="{Binding TicketType.Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"/>

                                    <Border Grid.Column="1"
                                            Padding="10,3"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            VerticalOptions="Start">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="paid">
                                                <Setter Property="BackgroundColor" Value="#DCFCE7"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="pending">
                                                <Setter Property="BackgroundColor" Value="#FEF3C7"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="checked_in">
                                                <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="cancelled">
                                                <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label FontSize="11" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="paid">
                                                    <Setter Property="Text" Value="Confirmado"/>
                                                    <Setter Property="TextColor" Value="#16A34A"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="Text" Value="Pendente"/>
                                                    <Setter Property="TextColor" Value="#D97706"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="checked_in">
                                                    <Setter Property="Text" Value="Finalizado"/>
                                                    <Setter Property="TextColor" Value="#2563EB"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="cancelled">
                                                    <Setter Property="Text" Value="Cancelado"/>
                                                    <Setter Property="TextColor" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                                        <mi:MauiIcon Icon="{mi:Cupertino TagCircleFill}"
                                                     Style="{StaticResource SmallIcon}"
                                                     IconSize="14"
                                                     IconColor="{StaticResource secondary_text_color}"/>
                                        <Label Text="{Binding TicketType.Name}"
                                               FontSize="13"
                                               TextColor="{StaticResource secondary_text_color}"/>
                                        <Label Text="•"
                                               FontSize="13"
                                               TextColor="{StaticResource secondary_text_color}"/>
                                        <Label FontSize="13"
                                               TextColor="{StaticResource primary_orange_color}"
                                               FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="R$ "/>
                                                    <Span Text="{Binding TicketType.Price, StringFormat='{0:F2}'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}"
                                           LineBreakMode="MiddleTruncation"
                                           Text="{Binding QrToken, StringFormat='QR: {0}'}"/>

                                    <!-- Tap to see QR code -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderDetailViewModel}}, Path=OpenTicketQrCodeCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
