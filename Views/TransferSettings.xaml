<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.TransferSettings"
             x:DataType="vm:TransferSettingsViewModel"
             Title="Configurações de Repasse"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <Label Text="←"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource primary_text_color}"
                       FontSize="18"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Configurações de Repasse"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="24">

                <!-- Info Banner -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="#F0F7FF"
                        Padding="16,14">
                    <Grid ColumnDefinitions="24, *" ColumnSpacing="12">
                        <Label Text="ⓘ" 
                               TextColor="#1E88E5" 
                               FontSize="18" 
                               VerticalOptions="Start"/>
                        <Label Grid.Column="1"
                               Text="Seus repasses são automáticos. Mantenha os dados atualizados para evitar atrasos no recebimento das vendas."
                               FontSize="12"
                               TextColor="#1E88E5"
                               LineHeight="1.2"/>
                    </Grid>
                </Border>

                <!-- Bank Accounts Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="CONTAS BANCÁRIAS"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               CharacterSpacing="1"/>
                        <Label Grid.Column="1"
                               Text="NOVA CONTA"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_orange_color}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddAccountCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{StaticResource White}"
                            Padding="0">
                        <Grid ColumnDefinitions="6, *">
                            <BoxView Grid.Column="0" 
                                     BackgroundColor="#E53935" 
                                     CornerRadius="3,0,3,0"
                                     WidthRequest="6"/>
                            
                            <Grid Grid.Column="1" ColumnDefinitions="60, *, Auto" Padding="12,16,16,16" ColumnSpacing="12">
                                <Border BackgroundColor="{StaticResource card_icon_bg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="48"
                                        HeightRequest="48">
                                    <Image Source="credit_card.png" 
                                           HeightRequest="22" 
                                           WidthRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding PrimaryAccount.BankName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Border BackgroundColor="#FFF1F0" 
                                                Padding="6,2" 
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                IsVisible="{Binding PrimaryAccount.IsDefault}">
                                            <Label Text="PADRÃO" 
                                                   FontSize="9" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#E53935"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding PrimaryAccount.BankDetails}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                    <Label Text="{Binding PrimaryAccount.AccountNumber}"
                                           FontSize="11"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" 
                                       Text="&gt;" 
                                       FontSize="18" 
                                       TextColor="{StaticResource chevron_color}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Pix Keys Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="CHAVES PIX"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               CharacterSpacing="1"/>
                        <Label Grid.Column="1"
                               Text="ADICIONAR CHAVE"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_orange_color}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddPixKeyCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PixKeys}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PixKey">
                                <Border Stroke="{StaticResource Gray100}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="16">
                                    <Grid ColumnDefinitions="48, *, Auto" ColumnSpacing="12">
                                        <Border BackgroundColor="{StaticResource card_icon_bg}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                WidthRequest="40"
                                                HeightRequest="40">
                                            <Image Source="qrcode.png" 
                                                   HeightRequest="18" 
                                                   WidthRequest="18"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Key}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource primary_text_color}"/>
                                            <Label Text="{Binding Type}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource secondary_text_color}"/>
                                        </VerticalStackLayout>

                                        <Image Grid.Column="2" 
                                               Source="trash.png" 
                                               HeightRequest="20" 
                                               WidthRequest="20"
                                               VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransferSettingsViewModel}}, Path=DeletePixKeyCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Footer: Security -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 30"
                        BackgroundColor="{StaticResource primary_text_color}"
                        Padding="24"
                        Margin="0,20,0,0">
                    <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView Color="#4CAF50" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center"/>
                            <Label Text="CONFORMIDADE FINANCEIRA" 
                                   FontSize="10" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource White}"
                                   CharacterSpacing="1"/>
                        </HorizontalStackLayout>

                        <Label Grid.Row="1"
                               Text="Segurança Máxima"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>

                        <Label Grid.Row="2"
                               Text="Suas informações bancárias são criptografadas e utilizadas exclusivamente para o repasse automatizado de suas vendas."
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               Opacity="0.7"
                               LineHeight="1.3"/>
                        
                        <!-- Background Shield Watermark -->
                        <Image Source="shield_check_light.png" 
                               Grid.RowSpan="3"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               HeightRequest="60"
                               Opacity="0.1"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
