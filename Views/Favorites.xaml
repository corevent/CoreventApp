<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.Favorites"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             Title="Favorites"
             BackgroundColor="{StaticResource background_color}">
    <ScrollView>
        <Grid RowDefinitions="auto, *" Padding="20" RowSpacing="20">
            <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                        IconColor="{StaticResource primary_text_color}"
                        IconSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1"
                    Text="Seus Favoritos"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource primary_text_color}"
                    VerticalOptions="Center"
                    Margin="12,0,0,0"/>
            </Grid>


            <Grid Grid.Row="1" RowDefinitions="auto, auto, auto" RowSpacing="20">
                <Border
        Stroke="{StaticResource Gray100}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 20"
        BackgroundColor="{StaticResource White}">
    <Grid ColumnDefinitions="72, *, Auto"
          Padding="14,14,14,14"
          ColumnSpacing="14">

        <!-- Thumbnail -->
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                HeightRequest="72"
                WidthRequest="72">
            <Image Source="https://images.unsplash.com/photo-1474511320723-9a56873867b5?w=400&amp;auto=format&amp;fit=crop"
                Aspect="AspectFill"/>
        </Border>

        <!-- Infos -->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="3"
                             VerticalOptions="Center">

            <Label Text="Vintage Culture – Open Air"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   LineBreakMode="TailTruncation"/>

            <HorizontalStackLayout Spacing="4">
                <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                       IconColor="{StaticResource secondary_text_color}"
                       IconSize="13"
                       VerticalOptions="Center"/>
                <Label Text="15 Out 2024"
                       FontSize="12"
                       TextColor="{StaticResource secondary_text_color}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="4">
                <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                       IconColor="{StaticResource secondary_text_color}"
                       IconSize="13"
                       VerticalOptions="Center"/>
                <Label Text="São Paulo, SP"
                       FontSize="12"
                       TextColor="{StaticResource secondary_text_color}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Label Text="R$ 250,00"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_orange_color}"
                   Margin="0,2,0,0"/>

        </VerticalStackLayout>

        <!-- Botão deletar -->
        <Border Grid.Column="2"
                WidthRequest="36"
                HeightRequest="36"
                StrokeThickness="1"
                Stroke="{StaticResource delete_stroke}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource delete_bg}"
                VerticalOptions="Center">
            
            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding DeleteFavoriteEventCommand}" 
                    CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>

            <mi:MauiIcon Icon="{mi:Cupertino Trash}"
                   IconColor="{StaticResource primary_text_color}"
                   IconSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Border>

    </Grid>
</Border>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
