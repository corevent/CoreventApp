<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.Home"
             Title="Home"
             BackgroundColor="{StaticResource background_color}">

  <Grid Padding="0"
        BackgroundColor="{StaticResource background_color}">
    <ScrollView>
      <VerticalStackLayout Padding="16,14,16,20"
                           Spacing="18">
        <Grid ColumnDefinitions="*, Auto"
              VerticalOptions="Center">
          <Label Text="Home"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"
                 VerticalOptions="Center"/>

          <Border Grid.Column="1"
                  WidthRequest="40"
                  HeightRequest="40"
                  Stroke="{StaticResource Gray200}"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource White}"
                  Padding="2">
            <Image Source="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120&amp;h=120&amp;fit=crop"
                   Aspect="AspectFill"/>
          </Border>
        </Grid>

        <Border Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="{StaticResource White}"
                Padding="12,10">
          <Grid ColumnDefinitions="50,*,36"
                ColumnSpacing="10">
                            <Border BackgroundColor="{StaticResource home_highlight_bg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                              <Label Text="Q"
                                     FontSize="24"
                                     TextColor="{StaticResource primary_orange_color}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>
                            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
              <Label Text="O que vamos fazer hoje?"
                     FontAttributes="Bold"
                     FontSize="16"
                     TextColor="{StaticResource primary_text_color}"/>
              <Label Text="Encontre shows, festas e mais..."
                     FontSize="13"
                     TextColor="{StaticResource secondary_text_color}"/>
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource card_icon_bg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center">
              <Label Text="F"
                     FontSize="15"
                     TextColor="{StaticResource home_filter_text}"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"/>
            </Border>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center">
          <Label Text="Destaques"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"/>
          <Label Grid.Column="1"
                 Text="Ver todos"
                 FontSize="14"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_orange_color}"
                 VerticalOptions="Center"/>
        </Grid>

        <ScrollView Orientation="Horizontal">
          <HorizontalStackLayout Spacing="12">
            <Border WidthRequest="290"
                    Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
              <Grid RowDefinitions="178, Auto">
                <Grid>
                  <Image Source="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=900&amp;auto=format&amp;fit=crop"
                         Aspect="AspectFill"/>
                  <Border Margin="12"
                          Padding="12,6"
                          StrokeThickness="0"
                          StrokeShape="RoundRectangle 14"
                          BackgroundColor="{StaticResource primary_orange_color}"
                          HorizontalOptions="Start"
                          VerticalOptions="End">
                    <Label Text="MUSICA"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"/>
                  </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1"
                                     Padding="14,12,14,14"
                                     Spacing="8">
                  <Label Text="Festival de Verão 2026"
                         FontSize="16"
                         FontAttributes="Bold"
                         TextColor="{StaticResource primary_text_color}"/>
                  <Label Text="15 Out, 2026 - 18:00"
                         FontSize="12"
                         TextColor="{StaticResource secondary_text_color}"/>
                  <VerticalStackLayout Spacing="0">
                    <Label Text="A PARTIR DE"
                           FontAttributes="Bold"
                           FontSize="10"
                           TextColor="{StaticResource secondary_text_color}"/>
                    <Label Text="R$ 150"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Grid>
            </Border>

            <Border WidthRequest="290"
                    Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
              <Grid RowDefinitions="178, Auto">
                <Grid>
                  <Image Source="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=900&amp;auto=format&amp;fit=crop"
                         Aspect="AspectFill"/>
                  <Border Margin="12"
                          Padding="12,6"
                          StrokeThickness="0"
                          StrokeShape="RoundRectangle 14"
                          BackgroundColor="{StaticResource primary_orange_color}"
                          HorizontalOptions="Start"
                          VerticalOptions="End">
                    <Label Text="TEC"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"/>
                  </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1"
                                     Padding="14,12,14,14"
                                     Spacing="8">
                  <Label Text="Tech Summit 2026"
                         FontSize="16"
                         FontAttributes="Bold"
                         TextColor="{StaticResource primary_text_color}"/>
                  <Label Text="22 Nov, 2026 - 09:00"
                         FontSize="12"
                         TextColor="{StaticResource secondary_text_color}"/>
                  <VerticalStackLayout Spacing="0">
                    <Label Text="A PARTIR DE"
                           FontAttributes="Bold"
                           FontSize="10"
                           TextColor="{StaticResource secondary_text_color}"/>
                    <Label Text="R$ 90"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Grid>
            </Border>
          </HorizontalStackLayout>
        </ScrollView>

        <Grid VerticalOptions="Center">
          <Label Text="Para você"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"/>
        </Grid>

        <ScrollView Orientation="Horizontal">
          <HorizontalStackLayout Spacing="12">
            <Border WidthRequest="168"
                    Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}">
              <Grid RowDefinitions="138, Auto">
                <Image Source="https://images.unsplash.com/photo-1529193591184-b1d58069ecdd?w=700&amp;auto=format&amp;fit=crop"
                       Aspect="AspectFill"/>
                <Label Grid.Row="1"
                       Padding="12,8"
                       Text="Gastronomia na brasa"
                       FontAttributes="Bold"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       TextColor="{StaticResource primary_text_color}"/>
              </Grid>
            </Border>

            <Border WidthRequest="168"
                    Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}">
              <Grid RowDefinitions="138, Auto">
                <Image Source="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=700&amp;auto=format&amp;fit=crop"
                       Aspect="AspectFill"/>
                <Label Grid.Row="1"
                       Padding="12,8"
                       Text="Workshop de fotografia"
                       FontAttributes="Bold"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       TextColor="{StaticResource primary_text_color}"/>
              </Grid>
            </Border>
          </HorizontalStackLayout>
        </ScrollView>
      </VerticalStackLayout>
    </ScrollView>

  </Grid>
</ContentPage>
