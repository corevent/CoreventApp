<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             x:Class="CoreventApp.Views.Home"
             x:DataType="vm:HomeViewModel"
             x:Name="ThisPage"
             Title="Home"
             BackgroundColor="{StaticResource background_color}">

  <Grid Padding="0"
        BackgroundColor="{StaticResource background_color}">
    <ScrollView>
      <VerticalStackLayout Padding="16,14,16,20"
                           Spacing="18">
        <Grid ColumnDefinitions="*, Auto"
              VerticalOptions="Center">
          <Label Text="Home"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"
                 VerticalOptions="Center"/>

          <Border Grid.Column="1"
                  WidthRequest="40"
                  HeightRequest="40"
                  Stroke="{StaticResource Gray200}"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource White}"
                  Padding="2">
            <Image Source="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120&amp;h=120&amp;fit=crop"
                   Aspect="AspectFill"/>
          </Border>
        </Grid>

        <Border Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="{StaticResource White}"
                Padding="12,10">
          <Grid ColumnDefinitions="50,*,36"
                ColumnSpacing="10">
            <Border BackgroundColor="{StaticResource home_highlight_bg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="50"
                    HeightRequest="50"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
              <mi:MauiIcon Icon="{mi:Cupertino Search}"
                           IconSize="24"
                           IconColor="{StaticResource primary_orange_color}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
              <Label Text="O que vamos fazer hoje?"
                     FontAttributes="Bold"
                     FontSize="16"
                     TextColor="{StaticResource primary_text_color}"/>
              <Label Text="Encontre shows, festas e mais..."
                     FontSize="13"
                     TextColor="{StaticResource secondary_text_color}"/>
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource card_icon_bg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center">
              <mi:MauiIcon Icon="{mi:Cupertino LineHorizontal3Decrease}"
                           IconSize="15"
                           IconColor="{StaticResource home_filter_text}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
            </Border>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center">
          <Label Text="Destaques"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"/>
          <Label Grid.Column="1"
                 Text="Ver todos"
                 FontSize="14"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_orange_color}"
                 VerticalOptions="Center"/>
        </Grid>

        <!-- Highlighted Events from API -->
        <ScrollView Orientation="Horizontal">
          <HorizontalStackLayout BindableLayout.ItemsSource="{Binding HighlightedEvents}"
                                 Spacing="12">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="dtos:EventListItemDto">
                <Border WidthRequest="290"
                        Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer
                      Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                      CommandParameter="{Binding}"/>
                  </Border.GestureRecognizers>
                  <Grid RowDefinitions="178, Auto">
                    <Grid>
                      <!-- Aplicar o titulo da placeholder no link atraves de binding context -->
                      <Image Source="https://placehold.co/600x400/FF5722/FFFFFF.png?text=Evento"
                             Aspect="AspectFill"/>
                      <Border Margin="12"
                              Padding="12,6"
                              StrokeThickness="0"
                              StrokeShape="RoundRectangle 14"
                              BackgroundColor="{StaticResource primary_orange_color}"
                              HorizontalOptions="Start"
                              VerticalOptions="End">
                        <Label Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>
                      </Border>
                    </Grid>
                    <VerticalStackLayout Grid.Row="1"
                                         Padding="14,12,14,14"
                                         Spacing="8">
                      <Label Text="{Binding Title}"
                             FontSize="16"
                             FontAttributes="Bold"
                             TextColor="{StaticResource primary_text_color}"/>
                      <Label Text="{Binding StartDate, StringFormat='{0:dd MMM, yyyy - HH:mm}'}"
                             FontSize="12"
                             TextColor="{StaticResource secondary_text_color}"/>
                    </VerticalStackLayout>
                  </Grid>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </HorizontalStackLayout>
        </ScrollView>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
