<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.CollaboratorEventDetail"
             x:DataType="vm:CollaboratorEventDetailViewModel"
             Title="Detalhes do Evento"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <Label Text="←"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource primary_text_color}"
                       FontSize="18"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Margin="12,0,0,0"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <Label Text="Detalhes do Evento"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"/>
                <Label Text="{Binding EventTitle}"
                       FontSize="12"
                       TextColor="{StaticResource secondary_text_color}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="20">

                <!-- Card Resumo -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="16">
                    <Grid ColumnDefinitions="72, *, 24" ColumnSpacing="12">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                HeightRequest="72"
                                WidthRequest="72">
                            <Image Source="{Binding EventImage}"
                                   Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding EventTitle}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>

                            <Label Text="{Binding EventDate}"
                                   FontSize="13"
                                   TextColor="{StaticResource secondary_text_color}"/>

                            <Border HorizontalOptions="Start"
                                    BackgroundColor="{Binding EventRoleColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8,4"
                                    Margin="0,4,0,0">
                                <Label Text="{Binding EventRole}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{Binding EventRoleTextColor}"/>
                            </Border>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="&gt;"
                               FontSize="16"
                               TextColor="{StaticResource Gray200}"
                               VerticalOptions="Start"
                               HorizontalOptions="End"/>
                    </Grid>
                </Border>

                <!-- ACESSO PERMITIDO -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="ACESSO PERMITIDO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource secondary_text_color}"
                           CharacterSpacing="1"
                           Margin="4,0"/>

                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource White}"
                            Padding="12,4">
                        <VerticalStackLayout Spacing="0">
                            <!-- Lista de Inscritos -->
                            <Grid ColumnDefinitions="40, *, Auto"
                                  HeightRequest="56">
                                <Border BackgroundColor="{StaticResource card_icon_bg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="user.png"
                                           HeightRequest="18"
                                           WidthRequest="18"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Margin="12,0"
                                                     Spacing="2">
                                    <Label Text="Lista de Inscritos"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"/>
                                    <Label Text="{Binding ParticipantCount, StringFormat='{0} participantes confirmados'}"
                                           FontSize="12"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="&gt;"
                                       FontSize="18"
                                       TextColor="{StaticResource chevron_color}"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenParticipantListCommand}"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                            <!-- Separator -->
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource Gray100}"
                                     Margin="48,0,0,0"
                                     IsVisible="{Binding IsCredenciamento}"/>

                            <!-- Realizar Credenciamento (apenas se for credenciamento) -->
                            <Grid ColumnDefinitions="40, *, Auto"
                                  HeightRequest="56"
                                  IsVisible="{Binding IsCredenciamento}">
                                <Border BackgroundColor="#111827"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36">
                                    <Image Source="qrcode_light.png"
                                           HeightRequest="18"
                                           WidthRequest="18"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Margin="12,0"
                                                     Spacing="2">
                                    <Label Text="Realizar Credenciamento"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"/>
                                    <Label Text="Leia o QR Code do ingresso"
                                           FontSize="12"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="&gt;"
                                       FontSize="18"
                                       TextColor="{StaticResource chevron_color}"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenScannerCommand}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Nota de Acesso -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource White}"
                        Padding="16">
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <Border BackgroundColor="#EFF6FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="40"
                                HeightRequest="40">
                            <Image Source="shield_check.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="Nota de Acesso"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Label Text="{Binding AccessNoteDescription}"
                                   FontSize="12"
                                   TextColor="{StaticResource secondary_text_color}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
