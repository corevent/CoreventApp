<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:cv="clr-namespace:CoreventApp.Converters"
             x:Class="CoreventApp.Views.PanelOrganizer"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:PanelOrganizerViewModel"
             x:Name="ThisPage"
             Title="Painel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:IntegerToVisibilityConverter x:Key="IntToVisibility"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             IconSize="18"
                             IconColor="{StaticResource primary_text_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Painel"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="18">

                <!-- Transfer Data Banner -->
                <Border Stroke="{StaticResource home_highlight_bg}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource home_highlight_bg}"
                        Padding="16,12">
                    <Grid ColumnDefinitions="48, *, Auto"
                          ColumnSpacing="12"
                          VerticalOptions="Center">
                        <Border BackgroundColor="{StaticResource card_icon_bg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                HorizontalOptions="Start">
                            <mi:MauiIcon Icon="{mi:Cupertino Creditcard}"
                                         IconSize="22"
                                         IconColor="{StaticResource secondary_text_color}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2">
                            <Label Text="Dados de Repasse"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Label Text="Configure como você recebe suas vendas"
                                   FontSize="11"
                                   TextColor="{StaticResource secondary_text_color}"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource White}"
                                Padding="12,4">
                            <Label Text="Configurar"
                                   TextColor="{StaticResource primary_orange_color}"
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConfigureTransferCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- Metrics Cards -->
                <Grid ColumnDefinitions="*, *"
                      ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource White}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource home_highlight_bg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    HorizontalOptions="Start">
                                <mi:MauiIcon Icon="{mi:Cupertino ChartBar}"
                                             IconSize="18"
                                             IconColor="{StaticResource secondary_text_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                            </Border>
                            <Label Text="RECEITA TOTAL"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Text="{Binding TotalRevenue}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource White}"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource card_icon_bg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    HorizontalOptions="Start">
                                <mi:MauiIcon Icon="{mi:Cupertino TagCircleFill}"
                                             IconSize="18"
                                             IconColor="{StaticResource secondary_text_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                            </Border>
                            <Label Text="INGRESSOS VENDIDOS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Text="{Binding TicketsSold}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>


                <!-- My Events Header -->
                <Grid ColumnDefinitions="*, Auto"
                      VerticalOptions="Center">
                    <Label Text="Meus Eventos"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="4">
                        <Label Text="+ Novo Evento"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_orange_color}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NewEventCommand}"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- Events List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyEvents}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventSummary">
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                                        CommandParameter="{Binding}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="80, *, Auto"
                                          ColumnSpacing="12">
                                        <Border WidthRequest="80"
                                                HeightRequest="80"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14">
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource primary_text_color}"/>
                                            <Label Text="{Binding Date}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource secondary_text_color}"/>

                                            <HorizontalStackLayout Spacing="8"
                                                                   Margin="0,4,0,0">
                                                <Border Padding="8,2"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="#E8F5E9">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding StatusDisplayText}"
                                                                     Value="EM ANDAMENTO">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding StatusDisplayText}"
                                                                     Value="ENCERRADO">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="#F3F4F6"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding StatusDisplayText}"
                                                                     Value="RASCUNHO">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="#FEF9C3"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding StatusDisplayText}"
                                                                     Value="CANCELADO">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding StatusDisplayText}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="#4CAF50">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding StatusDisplayText}"
                                                                         Value="EM ANDAMENTO">
                                                                <Setter Property="TextColor"
                                                                        Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding StatusDisplayText}"
                                                                         Value="ENCERRADO">
                                                                <Setter Property="TextColor"
                                                                        Value="#6B7280"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding StatusDisplayText}"
                                                                         Value="RASCUNHO">
                                                                <Setter Property="TextColor"
                                                                        Value="#A16207"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding StatusDisplayText}"
                                                                         Value="CANCELADO">
                                                                <Setter Property="TextColor"
                                                                        Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <mi:MauiIcon Grid.Column="2"
                                                     Icon="{mi:Cupertino ChevronRight}"
                                                     IconSize="18"
                                                     IconColor="{StaticResource chevron_color}"
                                                     VerticalOptions="Center"/>
                                    </Grid>

                                    <ProgressBar Progress="{Binding SalesProgress}"
                                                 ProgressColor="{StaticResource primary_orange_color}"/>

                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding TotalRevenue}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding SoldCount}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
