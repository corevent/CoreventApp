<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.EventDetail"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:EventDetailViewModel"
             Title="Detalhes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="12">

        <!-- Event Image with Overlay Actions -->
        <Grid Grid.Row="0"
              HeightRequest="320"
              VerticalOptions="Start">
            <Image Source="https://placehold.co/1000x500/FF5722/FFFFFF.png?text=Evento"
                   Aspect="AspectFill"
                   HeightRequest="320"/>

            <!-- Dark gradient overlay -->
            <BoxView HeightRequest="200"
                     VerticalOptions="Start"
                     Color="Transparent">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B0000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Top Action Bar -->
            <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                  Padding="16,14,16,0"
                  VerticalOptions="Start">

                <Border WidthRequest="40"
                        HeightRequest="40"
                        Stroke="#50FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#30FFFFFF">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                                 IconSize="18"
                                 IconColor="{StaticResource White}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Column="2"
                        WidthRequest="40"
                        HeightRequest="40"
                        Stroke="#50FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#30FFFFFF"
                        Margin="0,0,8,0">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowshapeTurnupRight}"
                                 IconSize="18"
                                 IconColor="{StaticResource White}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareEventCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Column="3"
                        WidthRequest="40"
                        HeightRequest="40"
                        Stroke="#50FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#30FFFFFF">
                    <Grid>
                        <mi:MauiIcon Icon="{mi:Cupertino HeartFill}"
                                     IconSize="18"
                                     IconColor="{StaticResource primary_orange_color}"
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                            <mi:MauiIcon.Triggers>
                                <DataTrigger TargetType="mi:MauiIcon" Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </mi:MauiIcon.Triggers>
                        </mi:MauiIcon>
                        <mi:MauiIcon Icon="{mi:Cupertino Heart}"
                                     IconSize="18"
                                     IconColor="{StaticResource White}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                            <mi:MauiIcon.Triggers>
                                <DataTrigger TargetType="mi:MauiIcon" Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </mi:MauiIcon.Triggers>
                        </mi:MauiIcon>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1"
                    Grid.RowSpan="2">
            <VerticalStackLayout Spacing="0">
                <!-- Rounded content card overlapping the image -->
                <Border BackgroundColor="{StaticResource background_color}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        Padding="20,20,20,120"
                        Margin="0,-24,0,0">
                    <VerticalStackLayout Spacing="18">

                        <!-- Category + Type Badges -->
                        <HorizontalStackLayout Spacing="8">
                            <Border Padding="12,6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource home_highlight_bg}">
                                <Label Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_orange_color}"/>
                            </Border>

                            <Border Padding="12,6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#DBEAFE"
                                    VerticalOptions="Center">
                                <Label Text="{Binding LocationTypeDisplay}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB"/>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Title -->
                        <Label Text="{Binding EventName}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"
                               LineBreakMode="WordWrap"/>

                        <!-- Date & Time -->
                        <Grid ColumnDefinitions="36, *"
                              ColumnSpacing="10">
                            <Border BackgroundColor="{StaticResource card_icon_bg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                             IconSize="18"
                                             IconColor="{StaticResource secondary_text_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Data e Horário"
                                       FontSize="11"
                                       TextColor="{StaticResource secondary_text_color}"/>
                                <Label Text="{Binding EventDate}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_text_color}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Location -->
                        <Grid ColumnDefinitions="36, *"
                              ColumnSpacing="10">
                            <Border BackgroundColor="{StaticResource card_icon_bg}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                                             IconSize="18"
                                             IconColor="{StaticResource secondary_text_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Local"
                                       FontSize="11"
                                       TextColor="{StaticResource secondary_text_color}"/>
                                <Label Text="{Binding Location}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_text_color}"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Organizer Card -->
                        <Border Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource White}"
                                Padding="14,12">
                            <Grid ColumnDefinitions="44, *, Auto"
                                  ColumnSpacing="12">
                                <Border WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22">
                                    <Image Source="{Binding OrganizerAvatar}"
                                           Aspect="AspectFill"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Organizador"
                                           FontSize="11"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                    <Label Text="{Binding OrganizerName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"/>
                                </VerticalStackLayout>
            <!-- Seguir button removed (not backed by API) -->
                            </Grid>
                        </Border>

                        <!-- Attractions / Programação (placeholder - API not integrated yet) -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Programação"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <VerticalStackLayout Spacing="8"
                                                 HorizontalOptions="Center"
                                                 Margin="0,12,0,0">
                                <Border BackgroundColor="{StaticResource card_icon_bg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        HorizontalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                                 IconSize="26"
                                                 IconColor="{StaticResource secondary_text_color}"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Nenhum detalhe de programação informado"
                                       FontSize="13"
                                       TextColor="{StaticResource secondary_text_color}"
                                       HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Bar -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{StaticResource White}"
                Padding="20,14,20,24"
                VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray200}"
                        Offset="0,-2"
                        Radius="12"
                        Opacity="0.4"/>
            </Border.Shadow>
            <Button Text="Comprar ingresso"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    Background="{StaticResource gradient_button}"
                    CornerRadius="14"
                    Command="{Binding BuyTicketCommand}"/>
        </Border>

    </Grid>

</ContentPage>
