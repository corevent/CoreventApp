<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.UpdatePassword"
             x:DataType="vm:UpdatePasswordViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="16,14,16,10" VerticalOptions="Center">
            <Border WidthRequest="40" HeightRequest="40" Stroke="{StaticResource Gray200}" StrokeThickness="1" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource White}">
                <Label Text="←" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource primary_text_color}" FontSize="18"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="Atualizar Senha" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource primary_text_color}" VerticalOptions="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20" Spacing="20">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Senha Atual" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource secondary_text_color}" Margin="4,0"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource White}" Padding="12,0" HeightRequest="50">
                        <Entry Text="{Binding CurrentPassword}" Placeholder="Digite sua senha atual" IsPassword="True" VerticalOptions="Center" TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Nova Senha" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource secondary_text_color}" Margin="4,0"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource White}" Padding="12,0" HeightRequest="50">
                        <Entry Text="{Binding NewPassword}" Placeholder="Digite a nova senha" IsPassword="True" VerticalOptions="Center" TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                    <Label Text="Mín. 8 caracteres, maiúscula, minúscula, número e símbolo." FontSize="11" TextColor="{StaticResource secondary_text_color}" Margin="4,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirmar Nova Senha" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource secondary_text_color}" Margin="4,0"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource White}" Padding="12,0" HeightRequest="50">
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="Confirme a nova senha" IsPassword="True" VerticalOptions="Center" TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource error_color}" FontSize="13" HorizontalTextAlignment="Center" IsVisible="{Binding ErrorMessage, Converter={StaticResource IntegerToVisibilityConverter}}"/>

                <Button Text="Atualizar Senha" 
                        Command="{Binding UpdatePasswordCommand}" 
                        BackgroundColor="{StaticResource primary_orange_color}" 
                        TextColor="{StaticResource White}" 
                        FontAttributes="Bold" 
                        CornerRadius="18" 
                        HeightRequest="56"
                        IsEnabled="{Binding IsNotBusy}"/>
                
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource primary_orange_color}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
