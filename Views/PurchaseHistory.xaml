<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.PurchaseHistory"
             Title="PurchaseHistory"
             BackgroundColor="{StaticResource background_color}">
    <ScrollView>
        <Grid RowDefinitions="auto, *" Padding="20" RowSpacing="20">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <Label Text="←"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="{StaticResource primary_text_color}"
                        FontSize="18"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1"
                    Text="Histórico"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource primary_text_color}"
                    VerticalOptions="Center"
                    Margin="12,0,0,0"/>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="auto, auto, auto" RowSpacing="20">
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <VerticalStackLayout>
                        <!-- Topo: thumbnail + info -->
                        <Grid ColumnDefinitions="72, *"
                            Padding="16,16,16,0"
                            ColumnSpacing="14">

                            <!-- Thumbnail quadrada -->
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    HeightRequest="72"
                                    WidthRequest="72">
                                <Image Source="https://www.eltonbrunetti.com.br/wp-content/uploads/2021/04/quadro-Leao-80-x-100-cm-Elton-Brunetti-scaled-jpg.webp"
                                    Aspect="AspectFill"/>
                            </Border>

                            <!-- Coluna direita -->
                            <VerticalStackLayout Grid.Column="1"
                                                Spacing="4">

                                <!-- Número do pedido + Badge status -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="ORD-2024-001"
                                        FontSize="11"
                                        TextColor="{StaticResource Gray400}"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"/>

                                    <Border Grid.Column="1"
                                            Padding="10,3"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource status_success_bg}">
                                        <Label Text="CONCLUÍDO"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource status_success_text}"/>
                                    </Border>
                                </Grid>

                                <!-- Título do evento -->
                                <Label Text="Vintage Culture - Open Air"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource primary_text_color}"
                                    LineBreakMode="TailTruncation"/>

                                <!-- Data e ingressos -->
                                <HorizontalStackLayout Spacing="16">
                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="calendar_icon.png"
                                            WidthRequest="13"
                                            HeightRequest="13"
                                            VerticalOptions="Center"/>
                                        <Label Text="15 Mar 2024"
                                            FontSize="12"
                                            TextColor="{StaticResource secondary_text_color}"
                                            VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="4">
                                        <Image Source="ticket_icon.png"
                                            WidthRequest="13"
                                            HeightRequest="13"
                                            VerticalOptions="Center"/>
                                        <Label Text="2 Ingressos"
                                            FontSize="12"
                                            TextColor="{StaticResource secondary_text_color}"
                                            VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Grid>

                        <!-- Divisor -->
                        <BoxView HeightRequest="0.5"
                                Margin="16,14,16,0"
                                Color="{StaticResource Gray100}"/>

                        <!-- Rodapé: preço + botões -->
                        <Grid ColumnDefinitions="*, Auto"
                            Padding="16,12,16,16"
                            VerticalOptions="Center">

                            <!-- Total pago -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TOTAL PAGO"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource secondary_text_color}"/>
                                <Label Text="R$ 250,00"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource primary_text_color}"/>
                            </VerticalStackLayout>

                            <!-- Botões -->
                            <HorizontalStackLayout Grid.Column="1"
                                                Spacing="8"
                                                VerticalOptions="Center">

                                <!-- Botão download -->
                                <Border WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Gray200}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource Gray50}">
                                    <Image Source="download.png"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <!-- Botão Ver Detalhes -->
                                <Border HeightRequest="40"
                                        Padding="18,0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource purchase_btn_bg}">
                                    <Label Text="Ver Detalhes"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource White}"
                                        VerticalOptions="Center"/>
                                </Border>

                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>