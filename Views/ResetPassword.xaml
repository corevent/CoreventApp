<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ViewModel="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.ResetPassword"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="ViewModel:ResetPasswordViewModel"
             Title="ResetPassword">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          BackgroundColor="{StaticResource background_color}"
          HorizontalOptions="Center">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center">
            <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                         IconSize="22"
                         IconColor="{StaticResource primary_text_color}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
                <mi:MauiIcon.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </mi:MauiIcon.GestureRecognizers>
            </mi:MauiIcon>

            <Image Grid.Column="1"
                   Source="logo_corevent_full.png"
                   HeightRequest="20"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   SemanticProperties.Description="Corevent Logo"/>
        </Grid>

        <!-- Content -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="16">

            <Border StrokeShape="RoundRectangle 40"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource home_highlight_bg}"
                    HeightRequest="80"
                    WidthRequest="80"
                    HorizontalOptions="Center">
                <mi:MauiIcon Icon="{mi:Cupertino LockOpen}"
                             IconSize="36"
                             IconColor="{StaticResource primary_orange_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
            </Border>

            <Label Text="Redefinir senha"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource primary_text_color}"/>

            <Label Text="Escolha uma nova senha para sua conta."
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   TextColor="{StaticResource secondary_text_color}"/>

            <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                <Label Text="Nova senha"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource secondary_text_color}"
                       Margin="4,0"/>
                <Border Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource input_color}"
                        Padding="12,0"
                        HeightRequest="50">
                    <Entry Text="{Binding NewPassword}"
                           Placeholder="Mínimo 6 caracteres"
                           IsPassword="True"
                           VerticalOptions="Center"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Confirmar senha"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource secondary_text_color}"
                       Margin="4,0"/>
                <Border Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource input_color}"
                        Padding="12,0"
                        HeightRequest="50">
                    <Entry Text="{Binding ConfirmPassword}"
                           Placeholder="Repita a senha"
                           IsPassword="True"
                           VerticalOptions="Center"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding IsError}"
                   TextColor="{StaticResource error_color}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource primary_orange_color}"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Bottom -->
        <VerticalStackLayout Grid.Row="2"
                             VerticalOptions="End"
                             Spacing="16"
                             Margin="0,0,0,20">
            <Button Text="Redefinir senha"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    Background="{StaticResource gradient_button}"
                    Command="{Binding ResetCommand}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
