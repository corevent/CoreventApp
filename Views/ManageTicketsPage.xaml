<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.ManageTicketsPage"
             x:DataType="vm:ManageTicketsViewModel"
             x:Name="ThisPage"
             Title="Gerenciar Ingressos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,20"
                             Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *"
                  VerticalOptions="Center">
                <Border Style="{StaticResource BackButtonContainer}">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1"
                       Text="Gerenciar Ingressos"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"/>
            </Grid>

            <!-- Add / Edit Ticket Type Card -->
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding FormTitle}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <Entry Text="{Binding NewName}"
                           Placeholder="Nome do ingresso (ex: VIP)"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="{StaticResource input_color}"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Entry Grid.Column="0"
                               Text="{Binding NewPrice}"
                               Placeholder="Preço"
                               Keyboard="Numeric"
                               TextColor="{StaticResource input_text}"
                               BackgroundColor="{StaticResource input_color}"/>
                        <Entry Grid.Column="1"
                               Text="{Binding NewTotalQuantity}"
                               Placeholder="Quantidade total"
                               Keyboard="Numeric"
                               TextColor="{StaticResource input_text}"
                               BackgroundColor="{StaticResource input_color}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <DatePicker Grid.Column="0"
                                    Date="{Binding NewStartDate}"
                                    TextColor="{StaticResource input_text}"
                                    BackgroundColor="{StaticResource input_color}"/>
                        <DatePicker Grid.Column="1"
                                    Date="{Binding NewEndDate}"
                                    TextColor="{StaticResource input_text}"
                                    BackgroundColor="{StaticResource input_color}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Button Text="{Binding FormButtonText}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                Background="{StaticResource gradient_button}"
                                Command="{Binding SaveTicketTypeCommand}"
                                CornerRadius="12"/>
                        <Button Grid.Column="1"
                                Text="Cancelar"
                                TextColor="{StaticResource secondary_text_color}"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                BackgroundColor="{StaticResource card_icon_bg}"
                                Command="{Binding CancelEditCommand}"
                                CornerRadius="12"
                                IsVisible="{Binding IsEditing}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Existing Tickets Section -->
            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding HasTickets}">
                <Label FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Ingressos Existentes"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TicketTypes}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TicketTypeViewModel">
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="12">
                                <Grid ColumnDefinitions="*, Auto, Auto"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Label Text="{Binding FormattedPrice}"
                                               FontSize="14"
                                               TextColor="{StaticResource primary_orange_color}"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding AvailableLabel}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"/>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource card_icon_bg}"
                                            VerticalOptions="Center">
                                        <mi:MauiIcon Icon="{mi:Cupertino Pencil}"
                                                     Style="{StaticResource ActionIcon}"
                                                     IconSize="16"
                                                     IconColor="{StaticResource primary_orange_color}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditTicketTypeCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="2"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource delete_bg}"
                                            VerticalOptions="Center">
                                        <mi:MauiIcon Icon="{mi:Cupertino Trash}" Style="{StaticResource ActionIcon}" IconSize="16" VerticalOptions="Center" HorizontalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteTicketTypeCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Empty state -->
            <Label Text="Nenhum tipo de ingresso cadastrado."
                   FontSize="14"
                   TextColor="{StaticResource secondary_text_color}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"
                   IsVisible="True">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasTickets}" Value="True">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
