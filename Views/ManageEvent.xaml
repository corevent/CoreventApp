<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.ManageEvent"
             x:DataType="vm:ManageEventViewModel"
             x:Name="ThisPage"
             Title="Gerenciar Evento"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,20"
                             Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *, Auto"
                  VerticalOptions="Center">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <Label Text="←"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{StaticResource primary_text_color}"
                           FontSize="18"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1"
                       Text="Gerenciar Evento"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"/>
            </Grid>

            <!-- Event Summary Card -->
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}"
                    Padding="12">
                <Grid ColumnDefinitions="80, *"
                      ColumnSpacing="12">
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                        <Image Source="{Binding EventImage}"
                               Aspect="AspectFill"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="{Binding EventName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="{Binding EventDate}"
                               FontSize="13"
                               TextColor="{StaticResource secondary_text_color}"/>
                        <Border BackgroundColor="#E8F5E9"
                                Padding="8,2"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                HorizontalOptions="Start"
                                Margin="0,4,0,0">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding StatusDisplayText}"
                                             Value="EM ANDAMENTO">
                                    <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding StatusDisplayText}"
                                             Value="ENCERRADO">
                                    <Setter Property="BackgroundColor" Value="#F3F4F6"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding StatusDisplayText}"
                                             Value="RASCUNHO">
                                    <Setter Property="BackgroundColor" Value="#FEF9C3"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding StatusDisplayText}"
                                             Value="CANCELADO">
                                    <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding StatusDisplayText}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#4CAF50">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding StatusDisplayText}"
                                                 Value="EM ANDAMENTO">
                                        <Setter Property="TextColor" Value="#2563EB"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding StatusDisplayText}"
                                                 Value="ENCERRADO">
                                        <Setter Property="TextColor" Value="#6B7280"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding StatusDisplayText}"
                                                 Value="RASCUNHO">
                                        <Setter Property="TextColor" Value="#A16207"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding StatusDisplayText}"
                                                 Value="CANCELADO">
                                        <Setter Property="TextColor" Value="#DC2626"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- KPI Cards (No Visualizações / Conversão) -->
            <Grid ColumnDefinitions="*, *"
                  ColumnSpacing="12">
                <Border Grid.Column="0"
                        Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource White}"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="{StaticResource home_highlight_bg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="32"
                                HeightRequest="32"
                                HorizontalOptions="Start">
                            <Image Source="chart_line.png"
                                   HeightRequest="18"
                                   WidthRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="RECEITA TOTAL"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"/>
                        <Label Text="{Binding TotalRevenue}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource White}"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="{StaticResource card_icon_bg}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="32"
                                HeightRequest="32"
                                HorizontalOptions="Start">
                            <Image Source="ticket.png"
                                   HeightRequest="18"
                                   WidthRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="INGRESSOS VENDIDOS"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"/>
                        <Label Text="{Binding TicketsSoldLabel}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Sales Progress -->
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Progresso de Vendas"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>
                    <ProgressBar Progress="{Binding SalesProgress}"
                                 ProgressColor="{StaticResource primary_orange_color}"/>
                    <Label Text="{Binding TicketsSoldLabel}"
                           FontSize="12"
                           TextColor="{StaticResource secondary_text_color}"
                           HorizontalOptions="End"/>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Actions -->
            <Label Text="Ações"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   Margin="0,4,0,0"/>

            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource White}"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Image Source="qrcode.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="Check-in e Portaria"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="Controle de acesso do evento"
                               FontSize="11"
                               TextColor="{StaticResource secondary_text_color}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="20"
                           TextColor="{StaticResource chevron_color}"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CheckInCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource White}"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Image Source="user.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="Lista de Participantes"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="Veja quem comprou ingressos"
                               FontSize="11"
                               TextColor="{StaticResource secondary_text_color}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="20"
                           TextColor="{StaticResource chevron_color}"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ParticipantListCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource White}"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Image Source="shield.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="Equipe"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="Gerencie sua equipe"
                               FontSize="11"
                               TextColor="{StaticResource secondary_text_color}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="20"
                           TextColor="{StaticResource chevron_color}"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TeamCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource White}"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Image Source="ticket.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="Gerenciar Ingressos"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="Configure lotes e preços"
                               FontSize="11"
                               TextColor="{StaticResource secondary_text_color}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="20"
                           TextColor="{StaticResource chevron_color}"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ManageTicketsCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource White}"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Image Source="settings.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="Editar Informações"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="Altere dados do evento"
                               FontSize="11"
                               TextColor="{StaticResource secondary_text_color}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="20"
                           TextColor="{StaticResource chevron_color}"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditEventCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Publish Button (only for Draft) -->
            <Button Text="Publicar Evento"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="48"
                    Background="{StaticResource gradient_button}"
                    CornerRadius="14"
                    Command="{Binding PublishEventCommand}"
                    IsVisible="{Binding CanPublish}"/>

            <!-- Cancel Button (only for Opened / Going) -->
            <Button Text="Cancelar Evento"
                    TextColor="{StaticResource error_color}"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="48"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource delete_stroke}"
                    BorderWidth="1"
                    CornerRadius="14"
                    Command="{Binding CancelEventCommand}"
                    IsVisible="{Binding CanCancel}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
