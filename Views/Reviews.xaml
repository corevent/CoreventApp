<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.Reviews"
             Title="Reviews"
             BackgroundColor="{StaticResource background_color}">
    <ScrollView>
        <Grid RowDefinitions="auto, *" Padding="20" RowSpacing="20">
            <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <Label Text="←"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="{StaticResource primary_text_color}"
                        FontSize="18"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1"
                    Text="Suas avaliações"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource primary_text_color}"
                    VerticalOptions="Center"
                    Margin="12,0,0,0"/>
            </Grid>


            <Grid Grid.Row="1" RowDefinitions="auto, auto, auto" RowSpacing="20">
                <Border
                        Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                    <VerticalStackLayout Padding="16" Spacing="0">
                        <!-- Topo: thumbnail + info -->
                        <Grid ColumnDefinitions="64, *"
                            ColumnSpacing="14"
                            Margin="0,0,0,14">

                            <!-- Thumbnail -->
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    HeightRequest="64"
                                    WidthRequest="64">
                                <Image Source="https://www.eltonbrunetti.com.br/wp-content/uploads/2021/04/quadro-Leao-80-x-100-cm-Elton-Brunetti-scaled-jpg.webp"
                                    Aspect="AspectFill"/>
                            </Border>

                            <!-- Título, data e estrelas -->
                            <VerticalStackLayout Grid.Column="1"
                                        Spacing="4"
                                        VerticalOptions="Center">

                                <Label Text="Vintage Culture – Open Air"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource primary_text_color}"
                                    LineBreakMode="TailTruncation"/>

                                <Label Text="16 Mar 2024"
                                    FontSize="13"
                                    TextColor="{StaticResource secondary_text_color}"/>

                                <!-- Estrelas -->
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="★" FontSize="18" TextColor="{StaticResource star_color}"/>
                                    <Label Text="★" FontSize="18" TextColor="{StaticResource star_color}"/>
                                    <Label Text="★" FontSize="18" TextColor="{StaticResource star_color}"/>
                                    <Label Text="★" FontSize="18" TextColor="{StaticResource star_color}"/>
                                    <Label Text="★" FontSize="18" TextColor="{StaticResource star_color}"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Grid>

                        <!-- Divisor -->
                        <BoxView HeightRequest="0.5"
                                Color="{StaticResource Gray100}"
                                Margin="0,0,0,14"/>

                        <!-- Comentário -->
                        <Label Text="&quot;Evento sensacional! Organização impecável e o som estava incrível.&quot;"
                            FontSize="14"
                            FontAttributes="Italic"
                            TextColor="{StaticResource secondary_text_color}"
                            LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>