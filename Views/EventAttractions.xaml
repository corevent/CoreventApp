<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.EventAttractions"
             x:DataType="vm:EventAttractionsViewModel"
             x:Name="ThisPage"
             Title="Programação"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,20"
                             Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *"
                  VerticalOptions="Center">
                <Border Style="{StaticResource BackButtonContainer}">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Margin="12,0,0,0"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label Text="Programação"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>
                    <Label Text="{Binding EventName}"
                           FontSize="12"
                           TextColor="{StaticResource secondary_text_color}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Add Attraction Card -->
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding FormTitle}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <Entry Text="{Binding NewTitle}"
                           Placeholder="Título da atração"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="{StaticResource input_color}"/>

                    <Entry Text="{Binding NewGuest}"
                           Placeholder="Nome do palestrante"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="{StaticResource input_color}"/>

                    <Label Text="Horário de início"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource input_color}"
                            Padding="12, 4">
                        <TimePicker Time="{Binding NewStartTime}"
                                    Format="HH:mm"
                                    TextColor="{StaticResource input_text}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    FontSize="15"/>
                    </Border>

                    <Label Text="Horário de término"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource input_color}"
                            Padding="12, 4">
                        <TimePicker Time="{Binding NewEndTime}"
                                    Format="HH:mm"
                                    TextColor="{StaticResource input_text}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    FontSize="15"/>
                    </Border>

                    <Button TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Background="{StaticResource gradient_button}"
                            Command="{Binding AddAttractionCommand}"
                            CornerRadius="12">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEditing}"
                                         Value="False">
                                <Setter Property="Text" Value="Adicionar"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEditing}"
                                         Value="True">
                                <Setter Property="Text" Value="Salvar"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Border Stroke="{StaticResource Gray300}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource White}"
                            Padding="14,10"
                            IsVisible="{Binding IsEditing}"
                            HorizontalOptions="Center">
                        <Label Text="Cancelar"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelEditCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Attractions List -->
            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding Attractions.Count}">
                <Label FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Atrações"/>
                            <Span Text="  "/>
                            <Span Text="{Binding Attractions.Count}"
                                  FontAttributes="None"
                                  TextColor="{StaticResource secondary_text_color}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attractions}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:Attraction">
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="12">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                      ColumnSpacing="12"
                                      RowDefinitions="Auto">
                                    <Border WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource card_icon_bg}">
                                        <mi:MauiIcon Icon="{mi:Cupertino MusicNote}"
                                                      IconSize="18"
                                                      IconColor="{StaticResource secondary_text_color}"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Label Text="{Binding Guest}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"/>
                                        <Border Padding="6,3"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#DBEAFE"
                                                HorizontalOptions="Start"
                                                Margin="0,4,0,0">
                                            <Label Text="{Binding FormattedTimeRange}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#2563EB"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource card_icon_bg}"
                                            VerticalOptions="Center">
                                        <mi:MauiIcon Icon="{mi:Cupertino Pencil}"
                                                      Style="{StaticResource ActionIcon}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditAttractionCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="3"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource delete_bg}"
                                            VerticalOptions="Center">
                                        <mi:MauiIcon Icon="{mi:Cupertino Trash}"
                                                      Style="{StaticResource ActionIcon}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveAttractionCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
