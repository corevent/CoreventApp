<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.Tickets"
             Title="Ingressos"
             BackgroundColor="{StaticResource background_color}">
  <ScrollView>

  <Grid  RowDefinitions="auto,auto, *" Padding="20" RowSpacing="20">
    <Label Text="Meus Ingressos"
           Grid.Row="0"
           FontSize="22"
           FontAttributes="Bold"
           TextColor="{StaticResource primary_text_color}"/>


    <Border Grid.Row="1" Padding="4" StrokeThickness="0" StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource Gray100}">
      <Grid ColumnDefinitions="*, *" ColumnSpacing="0">

        <!-- Botão Próximos -->
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 26">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsProximosVisible}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource toggle_active_bg}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsProximosVisible}" Value="False">
                    <Setter Property="BackgroundColor" Value="Transparent"/>
                </DataTrigger>
            </Border.Triggers>
            <Label Text="Próximos" HorizontalOptions="Center" Padding="0,10" FontAttributes="Bold" FontSize="14">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsProximosVisible}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource White}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsProximosVisible}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource secondary_text_color}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectProximosCommand}"/>
            </Border.GestureRecognizers>
        </Border>

        <!-- Botão Passados -->
        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 26">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsPassadosVisible}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource toggle_active_bg}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsPassadosVisible}" Value="False">
                    <Setter Property="BackgroundColor" Value="Transparent"/>
                </DataTrigger>
            </Border.Triggers>
            <Label Text="Passados" HorizontalOptions="Center" Padding="0,10" FontAttributes="Bold" FontSize="14">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPassadosVisible}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource White}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPassadosVisible}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource secondary_text_color}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectPassadosCommand}"/>
            </Border.GestureRecognizers>
        </Border>

    </Grid>
    </Border>

<!-- Conteúdo Próximos -->
<VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsProximosVisible}" Spacing="10">
    <Border
        Stroke="{StaticResource Gray100}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 20"
        BackgroundColor="{StaticResource White}">
    <Grid ColumnDefinitions="72, *"
          Padding="12"
          ColumnSpacing="12">

        <!-- Thumbnail -->
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                HeightRequest="72"
                WidthRequest="72">
            <Image Source="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=400&amp;auto=format&amp;fit=crop"
                   Aspect="AspectFill"/>
        </Border>

        <!-- Infos -->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="4"
                             VerticalOptions="Center">

            <Label Text="Tech Summit Brasil"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   LineBreakMode="TailTruncation"/>

            <HorizontalStackLayout Spacing="4">
                <Image Source="calendar.png"
                       WidthRequest="12" HeightRequest="12"
                       VerticalOptions="Center"/>
                <Label Text="22 Nov, 2026 • 09:00"
                       FontSize="12"
                       TextColor="{StaticResource secondary_text_color}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Local + Badge na mesma linha -->
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Image Source="map_icon.png"
                           WidthRequest="12" HeightRequest="12"
                           VerticalOptions="Center"/>
                    <Label Text="Centro de Convenções"
                           FontSize="12"
                           TextColor="{StaticResource secondary_text_color}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>
                </HorizontalStackLayout>

                <Border Grid.Column="1"
                        Padding="10,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#DCFCE7">
                    <Label Text="Confirmado"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#16A34A"/>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </Grid>
</Border>
</VerticalStackLayout>

<!-- Conteúdo Passados -->
<VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsPassadosVisible}">
    <Label Text="Conteúdo Passados" TextColor="{StaticResource primary_text_color}"/>
</VerticalStackLayout>
  </Grid>
  </ScrollView>
</ContentPage>
