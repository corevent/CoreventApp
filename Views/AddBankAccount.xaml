<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.AddBankAccount"
             x:DataType="vm:AddBankAccountViewModel"
             Title="Nova Conta Bancária"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <Label Text="←"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource primary_text_color}"
                       FontSize="18"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Nova Conta Bancária"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="18">

                <!-- Description -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Descrição (ex: Conta Principal)" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                        <Entry Text="{Binding Description}" Placeholder="Nome para identificar a conta" TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Bank Code -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Código do Banco" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                    <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                        <Entry Text="{Binding BankCode}" Placeholder="Ex: 260" Keyboard="Numeric" TextColor="{StaticResource primary_text_color}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Agency and Digit -->
                <Grid ColumnDefinitions="*, 80" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Agência" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                        <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                            <Entry Text="{Binding Agency}" Placeholder="0001" Keyboard="Numeric" TextColor="{StaticResource primary_text_color}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Dígito" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                        <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                            <Entry Text="{Binding AgencyDigit}" Placeholder="0" Keyboard="Numeric" TextColor="{StaticResource primary_text_color}"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Account and Digit -->
                <Grid ColumnDefinitions="*, 80" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Número da Conta" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                        <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                            <Entry Text="{Binding AccountNumber}" Placeholder="123456" Keyboard="Numeric" TextColor="{StaticResource primary_text_color}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Dígito" FontSize="13" TextColor="{StaticResource secondary_text_color}"/>
                        <Border Stroke="{StaticResource Gray100}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource White}" Padding="12,4">
                            <Entry Text="{Binding AccountDigit}" Placeholder="7" Keyboard="Numeric" TextColor="{StaticResource primary_text_color}"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Action Button -->
                <Button Text="Salvar Conta"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource primary_orange_color}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="56"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
