<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.CheckoutPage"
              xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
              xmlns:models="clr-namespace:CoreventApp.Models.Dtos"
             x:DataType="vm:CheckoutViewModel"
             Title="Checkout"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource White}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             IconSize="18"
                             IconColor="{StaticResource primary_text_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Checkout"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="24">
                
                <!-- Event Card -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="16">
                    <Grid ColumnDefinitions="80, *"
                          ColumnSpacing="16">
                        <Border WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                            <Image Source="{Binding EventImageUrl}"
                                   Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="{Binding EventName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Label Text="{Binding EventDate}"
                                   FontSize="13"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Text="{Binding SelectedTicketType.Price, StringFormat='R$ {0:F0}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_orange_color}"
                                   Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Ticket Type Selector -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="16,20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tipo de Ingresso"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"/>
                            <CollectionView ItemsSource="{Binding TicketTypes}"
                                            HeightRequest="180"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding SelectedTicketType}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TicketTypeDataDto">
                                    <Border StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="14,10"
                                            Margin="0,0,0,6"
                                            BackgroundColor="{StaticResource White}">
                                        <Grid ColumnDefinitions="*, Auto, Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"/>
                                                <Label FontSize="12"
                                                       TextColor="{StaticResource secondary_text_color}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} disponíveis">
                                                            <Binding Path="AvailableQuantity"/>
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   VerticalOptions="Center"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource primary_orange_color}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="R$ {0:F0}">
                                                        <Binding Path="Price"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                            <Border Grid.Column="2"
                                                    WidthRequest="20"
                                                    HeightRequest="20"
                                                    StrokeThickness="2"
                                                    StrokeShape="RoundRectangle 10"
                                                    VerticalOptions="Center"
                                                    Stroke="{StaticResource Gray200}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Quantity Selector -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="16,20">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Quantidade"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_text_color}"
                               VerticalOptions="Center"/>
                        
                        <HorizontalStackLayout Grid.Column="1"
                                             Spacing="16"
                                             VerticalOptions="Center">
                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource White}">
                                <mi:MauiIcon Icon="{mi:Cupertino Minus}"
                                             IconSize="18"
                                             IconColor="{StaticResource primary_text_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DecreaseQuantityCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Label Text="{Binding Quantity}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource primary_text_color}"
                                   VerticalOptions="Center"
                                   WidthRequest="20"
                                   HorizontalTextAlignment="Center"/>

                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource White}">
                                <mi:MauiIcon Icon="{mi:Cupertino Plus}"
                                             IconSize="18"
                                             IconColor="{StaticResource primary_text_color}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IncreaseQuantityCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Summary -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}"
                        Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Subtotal"
                                   TextColor="{StaticResource secondary_text_color}"
                                   FontSize="14"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}"
                                   TextColor="{StaticResource secondary_text_color}"
                                   FontSize="14"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Taxa de serviço (10%)"
                                   TextColor="{StaticResource secondary_text_color}"
                                   FontSize="14"/>
                            <Label Grid.Column="1"
                                   Text="{Binding ServiceFee, StringFormat='R$ {0:F2}'}"
                                   TextColor="{StaticResource secondary_text_color}"
                                   FontSize="14"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,4"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Total"
                                   TextColor="{StaticResource primary_text_color}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Total, StringFormat='R$ {0:F2}'}"
                                   TextColor="{StaticResource primary_text_color}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer Button -->
        <Border Grid.Row="2"
                Margin="16,10,16,20"
                HeightRequest="56"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Background="{StaticResource gradient_button}">
            <Grid ColumnDefinitions="Auto, *"
                  Padding="20,0">
                <ActivityIndicator IsRunning="{Binding IsPurchasing}"
                                   IsVisible="{Binding IsPurchasing}"
                                   Color="White"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="Finalizar Compra"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding FinalizePurchaseCommand}"/>
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>
