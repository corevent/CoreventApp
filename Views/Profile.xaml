<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CoreventApp.ViewModels"
             x:DataType="viewmodels:ProfileViewModel"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="CoreventApp.Views.Profile"
             Title="Perfil"
             BackgroundColor="{StaticResource background_color}">
    <Grid Padding="0">
        <ScrollView>
            <Grid RowDefinitions="auto,*">
                <Label Text="Perfil"
                       Grid.Row="0"
                       Padding="20"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}"/>

                <VerticalStackLayout Grid.Row="1"
                        Padding="20"
                        Spacing="40">
                    <VerticalStackLayout>
                        <Image
                            Source="{Binding UserAvatar}"
                            HeightRequest="70"
                             Aspect="AspectFit"
                             SemanticProperties.Description="Corevent Logo"/>

                        <Label Text="{Binding UserName}"
                               Padding="0,20,0,0"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Label Text="{Binding UserEmail}"
                               Padding="0,4,0,0"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource primary_text_color}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Border Padding="15"
                                BackgroundColor="{StaticResource White}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditProfileCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="20, *, 10">
                                <mi:MauiIcon Grid.Column="0"
                                        Icon="{mi:Cupertino Person}"
                                        IconSize="20"
                                        IconColor="{StaticResource secondary_text_color}"/>
                                <Label Text="Dados Pessoais"
                                        Padding="20,0,0,0"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        FontSize="16"
                                        TextColor="{StaticResource profile_menu_text}"/>
                                <mi:MauiIcon
                                        Icon="{mi:Cupertino ChevronRight}"
                                        IconSize="16"
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        IconColor="{StaticResource secondary_text_color}"/>
                            </Grid>
                        </Border>

                        <Border Padding="15"
                                BackgroundColor="{StaticResource White}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PurchaseHistoryCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="20, *, 10">
                                <mi:MauiIcon Grid.Column="0"
                                        Icon="{mi:Cupertino TagCircleFill}"
                                        IconSize="20"
                                        IconColor="{StaticResource secondary_text_color}"/>
                                <Label Text="Histórico de Compra"
                                        Padding="20,0,0,0"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        FontSize="16"
                                        TextColor="{StaticResource profile_menu_text}"/>
                                <mi:MauiIcon
                                        Icon="{mi:Cupertino ChevronRight}"
                                        IconSize="16"
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        IconColor="{StaticResource secondary_text_color}"/>
                            </Grid>
                        </Border>

                        <Border Padding="15"
                                BackgroundColor="{StaticResource White}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FavoritesCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="20, *, 10">
                                <mi:MauiIcon Grid.Column="0"
                                        Icon="{mi:Cupertino Heart}"
                                        IconSize="20"
                                        IconColor="{StaticResource secondary_text_color}"/>
                                <Label Text="Meus Favoritos"
                                        Padding="20,0,0,0"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        FontSize="16"
                                        TextColor="{StaticResource profile_menu_text}"/>
                                <mi:MauiIcon
                                        Icon="{mi:Cupertino ChevronRight}"
                                        IconSize="16"
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        IconColor="{StaticResource secondary_text_color}"/>
                            </Grid>
                        </Border>

                        <Border Padding="15"
                                BackgroundColor="{StaticResource White}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReviewsCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="20, *, 10">
                                <mi:MauiIcon Grid.Column="0"
                                        Icon="{mi:Cupertino Star}"
                                        IconSize="20"
                                        IconColor="{StaticResource secondary_text_color}"/>
                                <Label Text="Avaliações"
                                        Padding="20,0,0,0"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        FontSize="16"
                                        TextColor="{StaticResource profile_menu_text}"/>
                                <mi:MauiIcon
                                        Icon="{mi:Cupertino ChevronRight}"
                                        IconSize="16"
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        IconColor="{StaticResource secondary_text_color}"/>
                            </Grid>
                        </Border>

                        <Border Padding="15"
                                BackgroundColor="{StaticResource White}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SettingsCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="20, *, 10">
                                <mi:MauiIcon Grid.Column="0"
                                        Icon="{mi:Cupertino Gear}"
                                        IconSize="20"
                                        IconColor="{StaticResource secondary_text_color}"/>
                                <Label Text="Configurações"
                                        Padding="20,0,0,0"
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        FontSize="16"
                                        TextColor="{StaticResource profile_menu_text}"/>
                                <mi:MauiIcon
                                        Icon="{mi:Cupertino ChevronRight}"
                                        IconSize="16"
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        IconColor="{StaticResource secondary_text_color}"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="ORGANIZADOR"
                                Padding="0,0,0,4"
                                TextColor="{StaticResource secondary_text_color}"/>
                        <VerticalStackLayout>
                            <Border Padding="15"
                                    BackgroundColor="{StaticResource White}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PanelOrganizerCommand}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="20, *, 10">
                                    <mi:MauiIcon Grid.Column="0"
                                            Icon="{mi:Cupertino RectangleGrid2x2}"
                                            IconSize="20"
                                            IconColor="{StaticResource secondary_text_color}"/>

                                    <Label Grid.Column="1"
                                           Text="Painel do Organizador"
                                           Padding="20,0,0,0"
                                           VerticalOptions="Center"
                                           FontSize="16"
                                           TextColor="{StaticResource profile_menu_text}"/>

                                    <mi:MauiIcon
                                            Icon="{mi:Cupertino ChevronRight}"
                                            IconSize="16"
                                            Grid.Column="2"
                                            VerticalOptions="Center"
                                            IconColor="{StaticResource secondary_text_color}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="COLABORADOR"
                                Padding="0,0,0,4"
                                TextColor="{StaticResource secondary_text_color}"/>
                        <VerticalStackLayout>
                            <Border Padding="15"
                                    BackgroundColor="{StaticResource White}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PanelCollaboratorCommand}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="20, *, 10">
                                    <mi:MauiIcon Grid.Column="0"
                                            Icon="{mi:Cupertino Shield}"
                                            IconSize="20"
                                            IconColor="{StaticResource secondary_text_color}"/>

                                    <Label Grid.Column="1"
                                           Text="Painel do Colaborador"
                                           Padding="20,0,0,0"
                                           VerticalOptions="Center"
                                           FontSize="16"
                                           TextColor="{StaticResource profile_menu_text}"/>

                                    <mi:MauiIcon
                                            Icon="{mi:Cupertino ChevronRight}"
                                            IconSize="16"
                                            Grid.Column="2"
                                            VerticalOptions="Center"
                                            IconColor="{StaticResource secondary_text_color}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Button Text="Sair da Conta"
                            TextColor="{StaticResource primary_orange_color}"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Gray100}"
                            Command="{Binding LogoutCommand}"/>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
