<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CoreventApp"
             xmlns:converters="clr-namespace:CoreventApp.Converters"
             x:Class="CoreventApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CategoryDisplayConverter x:Key="CategoryDisplayConverter"/>
            <converters:LocationTypeDisplayConverter x:Key="LocationTypeDisplayConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
