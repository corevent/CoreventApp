<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoreventApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Views="clr-namespace:CoreventApp.Views"
    Shell.NavBarIsVisible="False"        
    Title="CoreventApp">

    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate Views:Welcome}"
        Route="welcome" />

    <TabBar Route="main">
        <ShellContent
            Title="Inicio"
            Icon="tab_icon_home.png"
            ContentTemplate="{DataTemplate Views:Home}"
            Route="home" />

        <ShellContent
            Title="Explorar"
            Icon="tab_icon_explore.png"
            ContentTemplate="{DataTemplate Views:Explore}"
            Route="explore" />

        <ShellContent
            Title="Ingressos"
            Icon="tab_icon_tickets.png"
            ContentTemplate="{DataTemplate Views:Tickets}"
            Route="tickets" />

        <ShellContent
            Title="Perfil"
            Icon="tab_icon_profile.png"
            ContentTemplate="{DataTemplate Views:Profile}"
            Route="profile" />
    </TabBar>

</Shell>
